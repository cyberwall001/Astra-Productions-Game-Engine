{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 - Visual Studio 2022",
      "description": "Astra Studio + KeyForge, the shipping target.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-msvc",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "ASTRA_BUILD_STUDIO": "ON",
        "ASTRA_BUILD_TOOLS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "headless",
      "displayName": "Headless tools (Ninja)",
      "description": "Self-check + UI preview tools. Works on any OS with a C++17 compiler.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ASTRA_BUILD_STUDIO": "OFF",
        "ASTRA_BUILD_TOOLS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "headless-debug",
      "inherits": "headless",
      "displayName": "Headless tools (Debug)",
      "binaryDir": "${sourceDir}/build/headless-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "headless",
      "configurePreset": "headless"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": { "outputOnFailure": true }
    }
  ]
}
